-- ===== FUNCTION TO CALCULATE SMOOTH =====
local function calculateSmooth(percentage)
    local value = math.max(1, math.min(144, percentage))
    return value / 100
end

-- ===== FUNCTION TO CALCULATE FOV SIZE =====
local function calculateFOVSize(percentage)
    local value = math.max(0, math.min(200, percentage))
    return (value / 100) * 200
end

-- ===== UPDATE SMOOTH =====
smoothBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local value = tonumber(smoothBox.Text)
        if value then
            value = math.max(1, math.min(144, value))
            smoothBox.Text = tostring(value)
            smoothness = calculateSmooth(value)
        else
            smoothBox.Text = "100"
            smoothness = calculateSmooth(100)
        end
    end
end)

-- ===== UPDATE FOV SIZE =====
fovSizeBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local value = tonumber(fovSizeBox.Text)
        if value then
            value = math.max(0, math.min(200, value))
            fovSizeBox.Text = tostring(value)
            FOV_PERCENT = value
            FOV_RADIUS = calculateFOVSize(value)
            
            if fovCircle then
                if FOV_RADIUS > 0 then
                    fovCircle.Radius = FOV_RADIUS
                    fovCircle.Visible = true
                else
                    fovCircle.Visible = false
                end
            end
        else
            fovSizeBox.Text = "100"
            FOV_PERCENT = 100
            FOV_RADIUS = calculateFOVSize(100)
        end
    end
end)

