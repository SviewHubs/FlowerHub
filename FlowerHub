local function updatePlayerList()
    for _, child in pairs(playerListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local ySize = 0
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            local playerButton = Instance.new("TextButton")
            playerButton.Size = UDim2.new(1, -8, 0, 25)
            playerButton.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
            playerButton.BackgroundTransparency = 0
            playerButton.BorderSizePixel = 0
            playerButton.Text = plr.Name
            playerButton.TextColor3 = whitelist[plr.Name] and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(255, 255, 255)
            playerButton.TextSize = 12
            playerButton.Font = Enum.Font.Gotham
            playerButton.TextXAlignment = Enum.TextXAlignment.Left
            playerButton.Parent = playerListFrame
            
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 4)
            btnCorner.Parent = playerButton
            
            playerButton.MouseButton1Click:Connect(function()
                if whitelist[plr.Name] then
                    whitelist[plr.Name] = nil
                    playerButton.TextColor3 = Color3.fromRGB(255, 255, 255)
                else
                    whitelist[plr.Name] = true
                    playerButton.TextColor3 = Color3.fromRGB(255, 0, 0)
                end
            end)
            
            ySize = ySize + 27
        end
    end
    
    playerListFrame.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

local function toggleWhitelist()
    whitelistOpen = not whitelistOpen
    
    if whitelistTween then
        whitelistTween:Cancel()
    end
    
    if lockAimOpen then
        lockAimOpen = false
        lockAimButton.Text = "LOCK AIM ▼"
        if lockAimTween then lockAimTween:Cancel() end
        lockAimFrame.Visible = false
        lockAimFrame.Size = UDim2.new(0, 130, 0, 0)
    end
    
    if whitelistOpen then
        whitelistButton.Text = "WHITELIST ▲"
        playerListFrame.Visible = true
        
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        whitelistTween = TweenService:Create(playerListFrame, tweenInfo, {Size = UDim2.new(0, 130, 0, 180)})
        whitelistTween:Play()
        
        local tweenLockAimButton = TweenService:Create(lockAimButton, tweenInfo, {Position = UDim2.new(0, 10, 0, 325)})
        tweenLockAimButton:Play()
        
        local tweenLockAimFrame = TweenService:Create(lockAimFrame, tweenInfo, {Position = UDim2.new(0, 10, 0, 365)})
        tweenLockAimFrame:Play()
        
        updatePlayerList()
    else
        whitelistButton.Text = "WHITELIST ▼"
        
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        whitelistTween = TweenService:Create(playerListFrame, tweenInfo, {Size = UDim2.new(0, 130, 0, 0)})
        whitelistTween:Play()
        
        local tweenLockAimButton = TweenService:Create(lockAimButton, tweenInfo, {Position = UDim2.new(0, 10, 0, 145)})
        tweenLockAimButton:Play()
        
        local tweenLockAimFrame = TweenService:Create(lockAimFrame, tweenInfo, {Position = UDim2.new(0, 10, 0, 185)})
        tweenLockAimFrame:Play()
        
        whitelistTween.Completed:Connect(function()
            if not whitelistOpen then
                playerListFrame.Visible = false
            end
        end)
    end
end

whitelistButton.MouseButton1Click:Connect(toggleWhitelist)

