-- ===== FUNCTION TO CREATE ANIMATED BLUR (WHITE) =====
local function createAnimatedBlur(parent, width, height, speed)
    parent.ClipsDescendants = true
    
    local blur = Instance.new("Frame")
    if height then
        blur.Size = UDim2.new(0, width, 0, height)
    else
        blur.Size = UDim2.new(0, width, 1, 0)
    end
    blur.Position = UDim2.new(0, -width, 0, 0)
    blur.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    blur.BackgroundTransparency = 0.5
    blur.BorderSizePixel = 0
    blur.Parent = parent
    blur.ZIndex = 1000
    
    -- WHITE Gradient
    local blurGradient = Instance.new("UIGradient")
    blurGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(200, 200, 200)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
    })
    blurGradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.8),
        NumberSequenceKeypoint.new(0.3, 0.3),
        NumberSequenceKeypoint.new(0.5, 0),
        NumberSequenceKeypoint.new(0.7, 0.3),
        NumberSequenceKeypoint.new(1, 0.8)
    })
    blurGradient.Parent = blur
    
    -- Animation
    local pos = -width
    local direction = 1
    
    coroutine.wrap(function()
        while blur.Parent do
            task.wait()
            pos = pos + (speed * direction)
            local parentWidth = parent.AbsoluteSize.X
            blur.Position = UDim2.new(0, pos, 0, 0)
            
            if pos >= parentWidth then
                direction = -1
            elseif pos <= -width then
                direction = 1
            end
        end
    end)()
    
    return blur
end

