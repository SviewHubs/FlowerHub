-- ===== PERSISTENT BLACKLIST SYSTEM =====
local HttpService = game:GetService("HttpService")
local dataFolder = "MenuScript_Data"
local blacklistFile = "blacklist.json"

-- Create folder to store data
if not isfolder(dataFolder) then
    makefolder(dataFolder)
end

-- Function to load blacklist
local function loadBlacklist()
    local path = dataFolder .. "/" .. blacklistFile
    if isfile(path) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(path))
        end)
        if success and type(result) == "table" then
            return result
        end
    end
    return {}
end

-- Function to save blacklist
local function saveBlacklist(blacklistData)
    local path = dataFolder .. "/" .. blacklistFile
    local success, err = pcall(function()
        writefile(path, HttpService:JSONEncode(blacklistData))
    end)
    if not success then
        warn("Error saving blacklist: " .. tostring(err))
    end
end

-- Function to validate nickname on Roblox (alternative method using Users API)
local function validateNickRoblox(nick)
    local success, result = pcall(function()
        -- Using Roblox Users API
        local url = "https://users.roblox.com/v1/usernames/users"
        local data = HttpService:JSONEncode({
            usernames = {nick},
            excludeBannedUsers = false
        })
        
        local response
        -- Try using syn.request if available
        if syn and syn.request then
            response = syn.request({
                Url = url,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = data
            })
        -- Try using request if available
        elseif request then
            response = request({
                Url = url,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = data
            })
        -- Try using http_request if available
        elseif http_request then
            response = http_request({
                Url = url,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = data
            })
        else
            return false, nil, nil, "No HTTP method available"
        end
        
        if response and response.Body then
            local decoded = HttpService:JSONDecode(response.Body)
            if decoded and decoded.data and #decoded.data > 0 then
                return true, decoded.data[1].id, decoded.data[1].name
            end
        end
        return false, nil, nil, "Nickname not found"
    end)
    
    if not success then
        return false, nil, nil, tostring(result)
    end
    
    return false, nil, nil, "Nickname not found"
end

-- Alternative function: validate using Get method
local function validateNickRobloxGet(nick)
    local success, result = pcall(function()
        local url = "https://api.roblox.com/users/get-by-username?username=" .. HttpService:UrlEncode(nick)
        
        local response
        if syn and syn.request then
            response = syn.request({
                Url = url,
                Method = "GET"
            })
        elseif request then
            response = request({
                Url = url,
                Method = "GET"
            })
        elseif http_request then
            response = http_request({
                Url = url,
                Method = "GET"
            })
        else
            return false, nil, nil, "No HTTP method available"
        end
        
        if response and response.Body then
            local decoded = HttpService:JSONDecode(response.Body)
            if decoded and decoded.Id and decoded.Id > 0 then
                return true, decoded.Id, decoded.Username
            end
        end
        return false, nil, nil, "Nickname not found"
    end)
    
    if not success then
        return false, nil, nil, tostring(result)
    end
    
    return false, nil, nil, "Nickname not found"
end

-- Function to validate nickname via Players (online player)
local function validateNickOnline(nick)
    -- Search for player ignoring case
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name:lower() == nick:lower() then
            return true, plr.UserId, plr.Name
        end
    end
    return false, nil, nil
end

