-- Function to add to blacklist (with validation)
local function addToBlacklist(nick)
    if not nick or nick == "" then
        showNotification("❌ Enter a nickname!", Color3.fromRGB(255, 100, 100))
        return
    end
    
    -- Check if already on blacklist
    for existingNick, _ in pairs(globalBlacklist) do
        if existingNick:lower() == nick:lower() then
            showNotification("⚠️ " .. existingNick .. " is already blacklisted!", Color3.fromRGB(255, 200, 0))
            blacklistNickBox.Text = ""
            return
        end
    end
    
    -- First check if online
    local online, userId, correctNick = validateNickOnline(nick)
    
    if online then
        -- Player is online, add directly
        globalBlacklist[correctNick] = {
            nick = correctNick,
            userId = userId,
            data = os.date("%Y-%m-%d %H:%M:%S")
        }
        saveBlacklist(globalBlacklist)
        updateBlacklistList()
        
        -- Kick the player
        local targetPlayer = Players:FindFirstChild(correctNick)
        if targetPlayer then
            targetPlayer:Kick("⛔ YOU HAVE BEEN BLACKLISTED!\nYou can no longer use this script.")
        end
        
        showNotification("✅ Blacklisted: " .. correctNick, Color3.fromRGB(0, 255, 0))
        blacklistNickBox.Text = ""
        return
    end
    
    -- If not online, try to validate on Roblox API
    showNotification("🔍 Validating nickname on API...", Color3.fromRGB(255, 200, 0))
    
    coroutine.wrap(function()
        -- Try POST method first
        local valid, userId, correctNick, errorMsg = validateNickRoblox(nick)
        
        -- If it fails, try GET method
        if not valid then
            valid, userId, correctNick, errorMsg = validateNickRobloxGet(nick)
        end
        
        if valid and correctNick then
            -- Valid nickname on Roblox
            -- Check again if already on blacklist (case insensitive)
            for existingNick, _ in pairs(globalBlacklist) do
                if existingNick:lower() == correctNick:lower() then
                    showNotification("⚠️ " .. existingNick .. " is already blacklisted!", Color3.fromRGB(255, 200, 0))
                    blacklistNickBox.Text = ""
                    return
                end
            end
            
            globalBlacklist[correctNick] = {
                nick = correctNick,
                userId = userId,
                data = os.date("%Y-%m-%d %H:%M:%S")
            }
            saveBlacklist(globalBlacklist)
            updateBlacklistList()
            
            showNotification("✅ Blacklisted: " .. correctNick .. " (offline)", Color3.fromRGB(0, 255, 0))
            blacklistNickBox.Text = ""
        else
            -- Invalid nickname
            showNotification("❌ Invalid nickname: " .. nick, Color3.fromRGB(255, 100, 100))
        end
    end)()
end

-- Function to kick player
local function kickPlayer(nick)
    if not nick or nick == "" then
        showNotification("❌ Enter a nickname!", Color3.fromRGB(255, 100, 100))
        return
    end
    
    -- Search for player ignoring case
    local targetPlayer = nil
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name:lower() == nick:lower() then
            targetPlayer = plr
            break
        end
    end
    
    if targetPlayer then
        targetPlayer:Kick("⛔ You have been kicked by an administrator!")
        showNotification("✅ Kicked: " .. targetPlayer.Name, Color3.fromRGB(0, 255, 0))
        kickNickBox.Text = ""
        return
    end
    
    -- If not online, show message
    showNotification("⚠️ Player not found online!", Color3.fromRGB(255, 200, 0))
end

